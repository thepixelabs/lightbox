# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Build outputs
target/
dist/
build/
node_modules/

# Rust
**/*.rs.bk
*.pdb

# Test fixtures: fetched by `cargo xtask fixtures`, never committed —
# only the pinned manifest is (E01 spec §2 workspace layout).
/fixtures/*
!/fixtures/manifest.toml

# Local scratch
*.log
.env
.env.*

# Lightbox catalogs created during local testing
*.lbdata/

# Editor and tooling scratch, never committed
.claude/
.tasks/

# Local, untracked pointer to DEVELOPMENT.md
CLAUDE.md

# Competitor feature research. Kept locally as working material, not published:
# it is of no use to anyone outside the project and reads badly next to the
# mandate's independent-implementation position.
/docs/research/

# Python bytecode from tools/site-checks
__pycache__/

# Internal planning and research record. Kept locally, not published: it is a
# working log of how the program was run rather than documentation anyone
# building or using Lightbox needs, and it carries process detail that has no
# business on a public repository. The two files with a machine consumer moved
# to docs/reference/ so `cargo xtask lint-migrations` and cargo-deny still work.
docs/plan/
docs/research/

# Full-resolution sources for the website imagery. 18 MB that nobody building
# or using Lightbox needs, and the files carry C2PA provenance metadata from
# the generator. The published WebP and JPEG derivatives under web/assets/img/
# are what the site serves; web/README.md records how they are produced.
assets/site-sources/

# Working plans and agent scratch. These live outside the repository by
# convention; this entry exists so that a stray write inside it cannot be
# committed by accident.
/rawplan/
/.plan/
/plans/
*.plan.md
